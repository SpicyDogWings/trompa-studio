{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": [
    "nodejs@26.12.0",
    "pnpm@12.9.0",
    "cargo@1.99.0",
    "rustc@1.99.0",
    "pkg-config@latest",
    "openssl@3",
    "patchelf@latest",
    "file@latest",
    "curl@latest",
    "wget@latest",
    "gtk3@latest",
    "webkitgtk_4_1@latest",
    "libsoup_3@latest",
    "librsvg@latest",
    "gdk-pixbuf@latest",
    "glib@latest",
    "cairo@latest",
    "pango@latest",
    "harfbuzz@latest",
    "at-spi2-atk@latest",
    "at-spi2-core@latest",
    "gobject-introspection@latest",
    "libayatana-appindicator@latest",
    "xdotool@latest",
    "nixpkgs#gtk3.dev",
    "nixpkgs#webkitgtk_4_1.dev",
    "nixpkgs#libsoup_3.dev",
    "nixpkgs#gdk-pixbuf.dev",
    "nixpkgs#glib.dev",
    "nixpkgs#cairo.dev",
    "nixpkgs#pango.dev",
    "nixpkgs#harfbuzz.dev",
    "nixpkgs#at-spi2-core.dev",
    "nixpkgs#libayatana-appindicator.dev",
    "postgresql@latest"
  ],
  "env": {
    "RUST_BACKTRACE": "1"
  },
  "shell": {
    "init_hook": [
      "export PKG_CONFIG_PATH=\"$DEVBOX_PACKAGES_DIR/lib/pkgconfig:$DEVBOX_PACKAGES_DIR/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}\"",
      "echo \"Nuxtri ▸ node $(node -v) · pnpm $(pnpm -v) · $(rustc -V)\""
    ],
    "scripts": {
      "setup": [
        "pnpm install"
      ],
      "dev": [
        "pnpm tauri dev"
      ],
      "dev:web": [
        "pnpm dev"
      ],
      "build": [
        "pnpm tauri build"
      ],
      "check": [
        "cargo check --manifest-path src-tauri/Cargo.toml"
      ],
      "db:start": [
        "mkdir -p .data /tmp/trompa-pg",
        "test -s .data/postgres/PG_VERSION || initdb -D .data/postgres -U postgres --auth-local=trust --auth-host=trust --encoding=UTF8 --locale=C",
        "pg_ctl status -D .data/postgres > /dev/null 2>&1 || pg_ctl -D .data/postgres -l .data/postgres.log -o \"-p 5432 -k /tmp/trompa-pg\" -w start"
      ],
      "db:stop": [
        "pg_ctl -D .data/postgres -m fast stop"
      ],
      "db:status": [
        "pg_isready -h 127.0.0.1 -p 5432 && psql -h 127.0.0.1 -p 5432 -U postgres -d postgres -c \"select version()\""
      ],
      "db:psql": [
        "psql -h 127.0.0.1 -p 5432 -U postgres -d postgres"
      ],
      "db:seed": [
        "psql -h 127.0.0.1 -p 5432 -U postgres -d postgres -tAc \"SELECT 1 FROM pg_database WHERE datname = 'trompa'\" | grep -q 1 || createdb -h 127.0.0.1 -p 5432 -U postgres trompa",
        "psql -h 127.0.0.1 -p 5432 -U postgres -d trompa -c \"CREATE TABLE IF NOT EXISTS clientes (id bigserial PRIMARY KEY, nombre text NOT NULL, email text UNIQUE, alta timestamptz NOT NULL DEFAULT now())\"",
        "psql -h 127.0.0.1 -p 5432 -U postgres -d trompa -c \"INSERT INTO clientes (nombre, email) VALUES ('Ada Lovelace', 'ada@example.com'), ('Alan Turing', 'alan@example.com'), ('Grace Hopper', 'grace@example.com') ON CONFLICT (email) DO NOTHING\"",
        "psql -h 127.0.0.1 -p 5432 -U postgres -d trompa -c \"SELECT id, nombre, email FROM clientes ORDER BY id\""
      ],
      "db:reset": [
        "pg_ctl -D .data/postgres -m immediate stop || true",
        "rm -rf .data/postgres .data/postgres.log"
      ]
    }
  }
}
